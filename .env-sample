# Copy to .env and fill in. .env is gitignored.
# Every new environment variable goes here.
APP_ENV=dev
PORT=8080

# Neon, region aws-sa-east-1 (São Paulo). One of the two is required.
# `neon init` writes these into .env.local, which is loaded automatically
# in development. DATABASE_URL_UNPOOLED (direct) wins when both are set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Integration tests only: the Neon branch "test". They write and delete
# rows, so they never fall back to DATABASE_URL and skip when this is empty.
TEST_DATABASE_URL=

# Header the reverse proxy puts the client's IP in, used by the login
# rate limit. Fly sets Fly-Client-IP (see fly.toml). Leave empty when
# nothing sits in front of the server, or clients could pick their own IP.
CLIENT_IP_HEADER=

# Cloudflare R2, where product photos are stored. Required in production
# (fly secrets), all four together. In development, leave them empty to
# keep photos in MEDIA_DIR, served by the API under /media.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address (an r2.dev subdomain or a custom domain),
# without a trailing slash. Required with R2; https in production.
# In development without R2 it defaults to http://localhost:$PORT/media.
IMAGE_BASE_URL=
# Development only, without R2. Defaults to .media (gitignored).
MEDIA_DIR=
