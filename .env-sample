# Copy to .env and fill in. .env is gitignored.
# Every new environment variable goes here.
APP_ENV=dev
PORT=8080

# Neon, region aws-sa-east-1 (São Paulo). One of the two is required.
# `neon init` writes these into .env.local, which is loaded automatically
# in development. DATABASE_URL_UNPOOLED (direct) wins when both are set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
